+def test_host_cancellation_does_not_poison_callers_task(loopback):
+    configure(loopback)
+    loopback["slow_headers"] = True
+    event = threading.Event()
+
+    async def run():
+        owner = asyncio.current_task()
+        assert owner is not None
+        assert owner.cancelling() == 0
+
+        async def signal_host_cancel():
+            deadline = asyncio.get_running_loop().time() + 2
+            while not loopback["received"].is_set():
+                assert asyncio.get_running_loop().time() < deadline
+                await asyncio.sleep(0.01)
+            event.set()
+
+        signaler = asyncio.create_task(signal_host_cancel())
+        try:
+            with aux.aux_interrupt_protection(cancel_event=event):
+                with pytest.raises(aux.AuxiliaryExplicitCancellation):
+                    # Await in the owner's long-lived task, not a throwaway one.
+                    await aux.async_call_llm(task="title_generation", messages=[{
+                        "role": "user", "content": "Repair cache",
+                    }])
+            assert owner.cancelling() == 0
+
+            async def child_failure():
+                raise ValueError("expected child error")
+
+            with pytest.raises(ExceptionGroup):
+                async with asyncio.TaskGroup() as group:
+                    group.create_task(child_failure())
+            await asyncio.sleep(0)  # No stale/spurious CancelledError.
+        finally:
+            signaler.cancel()
+            await asyncio.gather(signaler, return_exceptions=True)
+
+    asyncio.run(run())
+    assert_wire(loopback)
+
+
+@pytest.mark.parametrize("task", ["title_generation", "profile_describer", "local_helper"])
+@pytest.mark.parametrize("warm", [False, True])
+@pytest.mark.parametrize("mode", ["sync", "async"])
+def test_unreadable_policy_never_reverts_to_ordinary_routing(loopback, task, warm, mode):
+    from agent.qualified_local_helper import LocalHelperError
+    from hermes_constants import get_hermes_home
+
+    configure(loopback, task=task)
+    if warm:
+        assert aux._get_auxiliary_task_config(task)["fallback_enabled"] is False
+    (get_hermes_home() / "config.yaml").write_text("auxiliary: [unterminated\n")
+    with pytest.raises(LocalHelperError, match="policy cannot be read"):
+        invoke(mode, task=task)
+    assert not loopback["requests"]
+
+
+def test_closed_async_loops_are_collectible_after_contended_helpers(loopback):
+    configure(loopback)
