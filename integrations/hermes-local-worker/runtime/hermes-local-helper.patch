diff --git a/agent/qualified_local_helper.py b/agent/qualified_local_helper.py
new file mode 100644
index 0000000000..c05f84a6cc
--- /dev/null
+++ b/agent/qualified_local_helper.py
@@ -0,0 +1,530 @@
+"""Opt-in, tool-free auxiliary requests with no provider discovery or fallback.
+
+This is a protocol boundary, not a model-quality/admission check. The parent
+chooses an already qualified model and treats all returned text as untrusted.
+"""
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import copy
+import errno
+import functools
+import json
+import math
+import re
+import selectors
+import socket
+import threading
+import time
+import weakref
+from dataclasses import dataclass
+from types import SimpleNamespace
+from typing import Callable, cast
+
+import httpcore
+
+from hermes_constants import hermes_home_key
+
+_TASKS = frozenset({"title_generation", "profile_describer", "local_helper"})
+_PROVIDERS = frozenset({"llama.cpp", "llama-cpp", "llamacpp"})
+_ENDPOINT = re.compile(r"http://(127\.0\.0\.1|\[::1\]):([1-9][0-9]{0,4})(/|/v1/?)?\Z")
+_DEFAULT_CAPS = {"timeout": 15.0, "max_tokens": 512,
+                 "max_input_chars": 16384, "max_response_bytes": 65536}
+_HEADERS = [(b"Content-Type", b"application/json"), (b"Accept", b"application/json"),
+            (b"Accept-Encoding", b"identity"), (b"Connection", b"close")]
+
+# Only active callers/waiters own a permit. Weak values release idle entries,
+# including loop-bound semaphores; weak loop identity cannot alias a recycled id.
+_async_semaphores = weakref.WeakValueDictionary()
+_async_sem_lock = threading.Lock()
+
+
+class LocalHelperError(RuntimeError):
+    """Local policy, protocol or content refusal; never retry/fallback eligible."""
+
+
+class _LocalAsyncSemaphore(asyncio.BoundedSemaphore):
+    def __init__(self, limit):
+        super().__init__(limit)
+        self.limit = limit
+
+
+def _async_semaphore(call):
+    key = (call.home, call.task, weakref.ref(asyncio.get_running_loop()))
+    with _async_sem_lock:
+        semaphore = _async_semaphores.get(key)
+        if semaphore is None or semaphore.limit != call.concurrency:
+            semaphore = _LocalAsyncSemaphore(call.concurrency)
+            _async_semaphores[key] = semaphore
+        return semaphore
+
+
+@dataclass(frozen=True)
+class LocalCall:
+    task: str
+    home: str
+    provider: str
+    model: str
+    url: str
+    timeout: float
+    max_tokens: int
+    max_response_bytes: int
+    concurrency: int
+    payload: bytes
+    title_json: bool
+    cancel_check: Callable | None
+
+
+def _integer(value, label, maximum):
+    if type(value) is not int or not 1 <= value <= maximum:
+        raise LocalHelperError(f"local helper {label} must be a bounded positive integer")
+    return value
+
+
+def _seconds(value):
+    if type(value) not in (float, int) or not 0.05 <= value <= 30 or not math.isfinite(value):
+        raise LocalHelperError("local helper timeout must be finite and between 0.05 and 30 seconds")
+    return float(value)
+
+
+def _local_identity(cfg, provider, model, base_url):
+    pinned_provider, pinned_model, endpoint = (cfg.get(k) for k in ("provider", "model", "base_url"))
+    if not isinstance(pinned_provider, str) or pinned_provider not in _PROVIDERS:
+        raise LocalHelperError("local helper requires an explicit supported llama.cpp provider")
+    if (not isinstance(pinned_model, str) or not pinned_model or len(pinned_model) > 256
+            or pinned_model.lower() == "auto" or any(c.isspace() or ord(c) < 32 for c in pinned_model)):
+        raise LocalHelperError("local helper requires a literal pinned model")
+    match = _ENDPOINT.fullmatch(endpoint) if isinstance(endpoint, str) else None
+    if match is None or int(match[2]) > 65535:
+        raise LocalHelperError("local helper requires an explicit literal loopback HTTP endpoint")
+    for override, pinned in ((provider, pinned_provider), (model, pinned_model), (base_url, endpoint)):
+        if override is not None and override != pinned:
+            raise LocalHelperError("local helper request cannot override its pinned identity")
+    return pinned_provider, pinned_model, match
+
+
+def _caller_controls(task, extra_body, reasoning_config, temperature):
+    # These are fixed controls from the REAL callers, not a general extra_body
+    # escape hatch. Enforce title JSON locally; never forward either control.
+    title_json = False
+    if extra_body is not None:
+        if task != "title_generation":
+            raise LocalHelperError("local helper forbids extra_body")
+        from agent.title_generator import _TITLE_RESPONSE_FORMAT
+        if extra_body != {"response_format": _TITLE_RESPONSE_FORMAT}:
+            raise LocalHelperError("local helper only accepts the fixed title response contract")
+        title_json = True
+    if reasoning_config is not None and not (
+            task == "title_generation" and isinstance(reasoning_config, dict)
+            and set(reasoning_config) == {"enabled"} and reasoning_config["enabled"] is False):
+        raise LocalHelperError("local helper forbids reasoning overrides")
+    if temperature is not None and not (task == "profile_describer" and type(temperature) is float and temperature == 0.3):
+        raise LocalHelperError("local helper forbids temperature overrides")
+    return title_json
+
+
+# Only the fixed protocol inputs cross this boundary; ordinary SDK controls and
+# diagnostic mappings stay out. Both public wrappers retain their own signatures.
+_LOCAL_REQUEST_FIELDS = (
+    "task", "messages", "provider", "model", "base_url", "api_key", "temperature",
+    "max_tokens", "tools", "timeout", "extra_body", "reasoning_config",
+    "extra_headers", "api_mode", "stream", "stream_options",
+)
+
+
+def _prepare_request(request):
+    return prepare_local_call(**{field: request[field] for field in _LOCAL_REQUEST_FIELDS if field in request})
+
+
+def call_local_if_enabled(request):
+    call = _prepare_request(request)
+    if call is None:
+        return None
+    return call_local(call, route_info=request.get("route_info"), latency_info=request.get("latency_info"))
+
+
+async def acall_local_if_enabled(request):
+    call = _prepare_request(request)
+    if call is None:
+        return None
+    return await acall_local(call, route_info=request.get("route_info"))
+
+
+def prepare_local_call(task, *, messages, provider=None, model=None, base_url=None,
+                       api_key=None, temperature=None, max_tokens=None, tools=None,
+                       timeout=None, extra_body=None, reasoning_config=None,
+                       extra_headers=None, api_mode=None, stream=False, stream_options=None):
+    """One copied task-policy snapshot, used for validation, queueing and transport."""
+    from agent import auxiliary_client as aux
+
+    cfg = copy.deepcopy(aux._get_auxiliary_task_config(task))
+    from hermes_cli.config_read_errors import FailedConfigRead
+    if task in _TASKS and isinstance(cfg, FailedConfigRead):
+        context = aux._RELAY_AUX_CALL_CONTEXT.get()
+        if context is not None:
+            context["local_only"] = True
+        raise LocalHelperError("local helper policy cannot be read; refusing ordinary fallback")
+    fallback = cfg.get("fallback_enabled", True)
+    if type(fallback) is not bool:
+        raise LocalHelperError("fallback_enabled must be a boolean")
+    if fallback:
+        if task == "local_helper":
+            raise LocalHelperError("local_helper requires explicit fallback_enabled=false")
+        return None
+    context = aux._RELAY_AUX_CALL_CONTEXT.get()
+    if context is not None:
+        context["local_only"] = True
+    if task not in _TASKS:
+        raise LocalHelperError("no-fallback local helpers are restricted to low-risk text tasks")
+    pinned_provider, pinned_model, match = _local_identity(cfg, provider, model, base_url)
+    if (api_key is not None or cfg.get("api_key") not in (None, "")
+            or cfg.get("key_env") not in (None, "") or cfg.get("api_key_env") not in (None, "")
+            or extra_headers is not None or tools is not None or stream or stream_options is not None
+            or cfg.get("extra_body") not in (None, {})
+            or cfg.get("api_mode") not in (None, "", "chat_completions")
+            or api_mode not in (None, "chat_completions")
+            or cfg.get("reasoning_effort") not in (None, "", "none")
+            or any(cfg.get(k) for k in ("extra_headers", "headers", "default_headers", "tools", "stream"))):
+        raise LocalHelperError("local helper forbids credentials, tools and wire overrides")
+    title_json = _caller_controls(task, extra_body, reasoning_config, temperature)
+    caps = cfg.get("local_helper_caps", {})
+    if not isinstance(caps, dict) or set(caps) - _DEFAULT_CAPS.keys():
+        raise LocalHelperError("invalid local_helper_caps")
+    caps = {**_DEFAULT_CAPS, **caps}
+    seconds = _seconds(caps["timeout"])
+    output_limit = _integer(caps["max_tokens"], "max_tokens", 1024)
+    input_limit = _integer(caps["max_input_chars"], "max_input_chars", 32768)
+    response_limit = _integer(caps["max_response_bytes"], "max_response_bytes", 131072)
+    concurrency = _integer(cfg.get("max_concurrency", 1), "max_concurrency", 8)
+    if timeout is not None:
+        if _seconds(timeout) > seconds:
+            raise LocalHelperError("request timeout exceeds local helper cap")
+        seconds = float(timeout)
+    if max_tokens is not None:
+        if _integer(max_tokens, "max_tokens", 1024) > output_limit:
+            raise LocalHelperError("request max_tokens exceeds local helper cap")
+        output_limit = max_tokens
+    if not isinstance(messages, list) or not 1 <= len(messages) <= 32:
+        raise LocalHelperError("local helper requires a bounded list of text messages")
+    clean = []
+    total = 0
+    for message in messages:
+        if (not isinstance(message, dict) or set(message) != {"role", "content"}
+                or message["role"] not in ("system", "user", "assistant")
+                or not isinstance(message["content"], str)):
+            raise LocalHelperError("local helper accepts only tool-free text messages")
+        total += len(message["content"])
+        if total > input_limit:
+            raise LocalHelperError("local helper input exceeds its cap")
+        clean.append(dict(message))
+    try:
+        payload = json.dumps({"model": pinned_model, "messages": clean, "max_tokens": output_limit},
+                             ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
+    except (ValueError, UnicodeError) as exc:
+        raise LocalHelperError("local helper input is not valid UTF-8 JSON") from exc
+    if len(payload) > 131072:
+        raise LocalHelperError("local helper request exceeds its byte cap")
+    return LocalCall(task, hermes_home_key(), pinned_provider, pinned_model,
+                     f"http://{match[1]}:{match[2]}/v1/chat/completions", seconds,
+                     output_limit, response_limit, concurrency, payload, title_json,
+                     aux._capture_aux_cancel_check())
+
+
+def _remaining(call, deadline):
+    from agent import auxiliary_client as aux
+    if call.cancel_check is not None and aux._captured_aux_cancel_requested(call.cancel_check):
+        raise aux.AuxiliaryExplicitCancellation()
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise TimeoutError("local helper absolute deadline expired")
+    return remaining
+
+
+def _check_headers(response, call):
+    if response.status != 200:
+        raise LocalHelperError("local helper refused HTTP status (redirects are never followed)")
+    for name, value in response.headers:
+        name = name.lower()
+        if name == b"content-encoding" and value.strip().lower() != b"identity":
+            raise LocalHelperError("local helper refuses compressed responses")
+        if name == b"content-type" and value.split(b";", 1)[0].strip().lower() != b"application/json":
+            raise LocalHelperError("local helper requires JSON responses")
+        if name == b"content-length":
+            if not value.isdigit() or int(value) > call.max_response_bytes:
+                raise LocalHelperError("local helper response exceeds its raw byte cap")
+
+
+def _append(raw, part, call):
+    if len(raw) + len(part) > call.max_response_bytes:
+        raise LocalHelperError("local helper response exceeds its raw byte cap")
+    raw.extend(part)
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON field")
+        result[key] = value
+    return result
+
+
+def _finite_json_float(value):
+    number = float(value)
+    if not math.isfinite(number):
+        raise ValueError("nonfinite JSON number")
+    return number
+
+
+def _decode(raw, call):
+    try:
+        data = json.loads(raw.decode("utf-8"), object_pairs_hook=_unique_object, parse_float=_finite_json_float,
+                          parse_constant=lambda _: (_ for _ in ()).throw(ValueError("nonfinite JSON")))
+        if not isinstance(data, dict) or data.get("error") or data.get("model", call.model) != call.model:
+            raise ValueError("invalid completion")
+        choices = data["choices"]
+        if not isinstance(choices, list) or len(choices) != 1 or not isinstance(choices[0], dict):
+            raise ValueError("invalid choices")
+        choice = choices[0]
+        message = choice["message"]
+        if (choice.get("finish_reason") != "stop" or not isinstance(message, dict)
+                or message.get("role") != "assistant"
+                or message.get("tool_calls") not in (None, []) or message.get("function_call") is not None
+                or message.get("refusal") is not None):
+            raise ValueError("refused or tool-bearing completion")
+        content = message["content"]
+        if not isinstance(content, str) or not content.strip() or len(content) > call.max_tokens * 16:
+            raise ValueError("empty or oversized content")
+        if call.title_json:
+            title = json.loads(content, object_pairs_hook=_unique_object)
+            if (not isinstance(title, dict) or set(title) != {"title"}
+                    or not isinstance(title["title"], str) or not title["title"].strip()):
+                raise ValueError("invalid fixed title contract")
+    except (ValueError, UnicodeError, KeyError, TypeError, RecursionError) as exc:
+        raise LocalHelperError("local helper returned invalid, refused or oversized text") from exc
+    return SimpleNamespace(model=call.model, usage=None, choices=[SimpleNamespace(
+        finish_reason="stop", message=SimpleNamespace(role="assistant", content=content, tool_calls=None))])
+
+
+def _extensions(call, deadline):
+    remaining = _remaining(call, deadline)
+    return {"timeout": dict.fromkeys(("connect", "read", "write", "pool"), remaining)}
+
+
+def _headers(call):
+    # httpcore otherwise drops IPv6 brackets when constructing its Host header.
+    authority = call.url.removeprefix("http://").split("/", 1)[0]
+    return [*_HEADERS, (b"Host", authority.encode("ascii"))]
+
+
+class _DeadlineSocket(httpcore.NetworkStream):
+    """Nonblocking I/O against ONE deadline, even inside a running event loop.
+
+    No alarm/signal manipulation or abandoned timeout worker. Polling also
+    observes explicit host cancellation while a peer sends nothing.
+    """
+
+    def __init__(self, sock, call, deadline):
+        self.sock, self.call, self.deadline = sock, call, deadline
+
+    def _wait(self, *, write=False):
+        # The gateway raises its nofile limit above FD_SETSIZE. Use the host's
+        # epoll/kqueue/poll implementation rather than select's descriptor cap.
+        with selectors.DefaultSelector() as selector:
+            selector.register(self.sock, selectors.EVENT_WRITE if write else selectors.EVENT_READ)
+            while True:
+                timeout = min(0.05, _remaining(self.call, self.deadline))
+                if selector.select(timeout):
+                    _remaining(self.call, self.deadline)
+                    return
+
+    def read(self, max_bytes, timeout=None):
+        while True:
+            self._wait()
+            try:
+                return self.sock.recv(max_bytes)
+            except (BlockingIOError, InterruptedError):
+                continue
+
+    def write(self, buffer, timeout=None):
+        pending = memoryview(buffer)
+        while pending:
+            self._wait(write=True)
+            try:
+                sent = self.sock.send(pending)
+            except (BlockingIOError, InterruptedError):
+                continue
+            if not sent:
+                raise httpcore.WriteError("local helper socket closed during send")
+            pending = pending[sent:]
+
+    def close(self):
+        self.sock.close()
+
+    def get_extra_info(self, info):
+        if info == "is_readable":
+            with selectors.DefaultSelector() as selector:
+                selector.register(self.sock, selectors.EVENT_READ)
+                return bool(selector.select(0))
+        if info == "socket":
+            return self.sock
+        return None
+
+
+class _DeadlineBackend(httpcore.NetworkBackend):
+    def __init__(self, call, deadline):
+        self.call, self.deadline = call, deadline
+
+    def connect_tcp(self, host, port, timeout=None, local_address=None, socket_options=None):
+        if host not in ("127.0.0.1", "::1"):
+            raise LocalHelperError("local helper transport refuses nonliteral hosts")
+        sock = socket.socket(socket.AF_INET6 if host == "::1" else socket.AF_INET, socket.SOCK_STREAM)
+        stream = _DeadlineSocket(sock, self.call, self.deadline)
+        try:
+            sock.setblocking(False)
+            _remaining(self.call, self.deadline)
+            result = sock.connect_ex((host, port))
+            if result not in (0, errno.EINPROGRESS, errno.EWOULDBLOCK, errno.EINTR):
+                raise httpcore.ConnectError("local helper loopback connection failed")
+            if result:
+                stream._wait(write=True)
+                if sock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR):
+                    raise httpcore.ConnectError("local helper loopback connection failed")
+            return stream
+        except BaseException:
+            stream.close()
+            raise
+
+
+def _send(call, deadline):
+    from agent import auxiliary_client as aux
+    raw = bytearray()
+    # httpcore streams RAW entity bytes and has no decompression, credential,
+    # proxy-env, cookie, redirect, SDK retry or request-rewrite machinery.
+    with httpcore.ConnectionPool(max_connections=1, max_keepalive_connections=0, retries=0,
+                                 network_backend=_DeadlineBackend(call, deadline)) as pool:
+        aux._notify_aux_dispatch()
+        with pool.stream("POST", call.url, headers=_headers(call), content=call.payload,
+                         extensions=_extensions(call, deadline)) as response:
+            _check_headers(response, call)
+            for part in response.iter_stream():
+                _remaining(call, deadline)
+                _append(raw, part, call)
+                aux._notify_aux_provider_response()
+    _remaining(call, deadline)
+    return _decode(raw, call)
+
+
+async def _asend(call, deadline):
+    from agent import auxiliary_client as aux
+    raw = bytearray()
+    async with httpcore.AsyncConnectionPool(max_connections=1, max_keepalive_connections=0, retries=0) as pool:
+        aux._notify_aux_dispatch()
+        async with pool.stream("POST", call.url, headers=_headers(call), content=call.payload,
+                               extensions=_extensions(call, deadline)) as response:
+            _check_headers(response, call)
+            async for part in response.aiter_stream():
+                _remaining(call, deadline)
+                _append(raw, part, call)
+                aux._notify_aux_provider_response()
+    _remaining(call, deadline)
+    return _decode(raw, call)
+
+
+def _observer_kwargs(call):
+    from agent import auxiliary_client as aux
+    context = aux._RELAY_AUX_CALL_CONTEXT.get() or {}
+    return dict(aux_task=call.task, metadata={"api_request_id": context.get("request_id", ""), "retry_count": 0},
+                client=SimpleNamespace(base_url=call.url.rsplit("/chat/completions", 1)[0]),
+                kwargs=json.loads(call.payload), provider=call.provider, model=call.model, api_mode="chat_completions")
+
+
+def call_local(call, *, route_info=None, latency_info=None):
+    from agent import auxiliary_client as aux
+    from agent.local_helper_observers import LocalObserverHooks
+    start = time.monotonic()
+    deadline = start + call.timeout
+    semaphore = aux._cached_semaphore(aux._aux_sync_semaphores, (call.home, call.task),
+                                      call.concurrency, threading.BoundedSemaphore)
+    while not semaphore.acquire(timeout=min(0.05, _remaining(call, deadline))):
+        pass
+    dispatched = time.monotonic()
+    try:
+        if latency_info is not None:
+            latency_info["queue_wait_ms"] = aux._elapsed_ms(start, dispatched)
+        aux._record_route_info(route_info, call.provider, call.model)
+        with (
+            aux._aux_thread_local_hook(aux._aux_dispatch, functools.partial(
+                aux._stamp_latency_once, latency_info, "provider_dispatch_ms", dispatched)),
+            aux._aux_thread_local_hook(aux._aux_provider_response, functools.partial(
+                aux._stamp_latency_once, latency_info, "time_to_first_progress_ms", dispatched)),
+        ):
+            hooks = LocalObserverHooks(call.home, deadline, **_observer_kwargs(call))
+            try:
+                hooks.notify(pre=True)
+                hooks.wait(lambda: _remaining(call, deadline))
+                response = _send(call, deadline)
+            except BaseException as exc:
+                hooks.notify(error=exc)  # Best effort only: never wait on an error/cancellation.
+                raise
+            hooks.notify(response=response)
+            hooks.wait(lambda: _remaining(call, deadline))
+        _remaining(call, deadline)
+        return response
+    finally:
+        if latency_info is not None:
+            latency_info["summary_generation_ms"] = aux._elapsed_ms(dispatched)
+        semaphore.release()
+
+
+async def acall_local(call, *, route_info=None):
+    from agent import auxiliary_client as aux
+    from agent.local_helper_observers import LocalObserverHooks
+    deadline = time.monotonic() + call.timeout
+    semaphore = _async_semaphore(call)
+    owner = cast(asyncio.Task, asyncio.current_task())
+    initial_cancelling = owner.cancelling()
+    host_cancelled = False
+
+    async def watch_cancel():
+        nonlocal host_cancelled
+        while not aux._captured_aux_cancel_requested(call.cancel_check):
+            await asyncio.sleep(0.05)
+        host_cancelled = True
+        owner.cancel()
+
+    # Native async cancellation closes the pool before returning. The optional
+    # host-event watcher is always cancelled AND joined; no abandoned workers.
+    watcher = asyncio.create_task(watch_cancel()) if call.cancel_check is not None else None
+    try:
+        async with asyncio.timeout(_remaining(call, deadline)):
+            await semaphore.acquire()
+            try:
+                aux._record_route_info(route_info, call.provider, call.model)
+                hooks = LocalObserverHooks(call.home, deadline, **_observer_kwargs(call))
+                try:
+                    hooks.notify(pre=True)
+                    await hooks.await_delivery(lambda: _remaining(call, deadline))
+                    response = await _asend(call, deadline)
+                except BaseException as exc:
+                    hooks.notify(error=exc)  # Do not delay native/host cancellation cleanup.
+                    raise
+                hooks.notify(response=response)
+                await hooks.await_delivery(lambda: _remaining(call, deadline))
+                _remaining(call, deadline)
+                return response
+            finally:
+                semaphore.release()
+    except asyncio.CancelledError:
+        if host_cancelled:
+            # Remove only the cancellation issued by our watcher. Preserve a
+            # concurrent external cancellation instead of swallowing it.
+            if owner.uncancel() <= initial_cancelling:
+                raise aux.AuxiliaryExplicitCancellation() from None
+        raise
+    finally:
+        if watcher is not None:
+            watcher.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await watcher
