+@pytest.fixture
+def loopback(request):
+    bind = getattr(request, "param", "127.0.0.1")
+    state = {"requests": [], "payload": completion(), "status": 200, "headers": {},
+             "raw": None, "trickle": False, "slow_headers": False, "disconnect": False, "chunked": False,
+             "received": threading.Event(), "closed": threading.Event()}
+
+    class Handler(BaseHTTPRequestHandler):
+        protocol_version = "HTTP/1.1"
+
+        def log_message(self, format, *args):
+            pass
+
+        def do_POST(self):
+            body = self.rfile.read(int(self.headers["Content-Length"]))
+            state["requests"].append((self.path, dict(self.headers), json.loads(body)))
+            state["received"].set()
+            if state["disconnect"]:
+                self.connection.shutdown(socket.SHUT_RDWR)
+                state["closed"].set()
+                return
+            raw = state["raw"]
+            if raw is None:
+                raw = json.dumps(state["payload"]).encode()
+            if state["slow_headers"]:
+                header = (b"HTTP/1.1 200 OK\r\nX-Padding: " + b"x" * 140 +
+                          f"\r\nContent-Length: {len(raw)}\r\n\r\n".encode())
+                try:
+                    for byte in header:
+                        self.wfile.write(bytes([byte]))
+                        self.wfile.flush()
+                        if state["closed"].wait(0.025):
+                            return
+                    self.wfile.write(raw)
+                except (BrokenPipeError, ConnectionResetError):
+                    state["closed"].set()
+                finally:
+                    self.close_connection = True
+                return
+            self.send_response(state["status"])
+            self.send_header("Content-Type", "application/json")
+            if state["chunked"]:
+                self.send_header("Transfer-Encoding", "chunked")
+            else:
+                self.send_header("Content-Length", str(len(raw)))
+            for name, value in state["headers"].items():
+                self.send_header(name, value)
+            self.end_headers()
+            try:
+                if state["trickle"]:
+                    # A response byte well inside each read timeout, indefinitely.
+                    for byte in raw:
+                        self.wfile.write(bytes([byte]))
+                        self.wfile.flush()
+                        if state["closed"].wait(0.025):
+                            break
+                elif state["chunked"]:
+                    for offset in range(0, len(raw), 1024):
+                        part = raw[offset:offset + 1024]
+                        self.wfile.write(f"{len(part):x}\r\n".encode() + part + b"\r\n")
+                        self.wfile.flush()
+                    self.wfile.write(b"0\r\n\r\n")
+                else:
+                    self.wfile.write(raw)
+                    self.wfile.flush()
+                self.connection.settimeout(3)
+                if self.connection.recv(1) == b"":
+                    state["closed"].set()
+            except (BrokenPipeError, ConnectionResetError):
+                state["closed"].set()
+            finally:
+                self.close_connection = True
+
+    class Server(ThreadingHTTPServer):
+        address_family = socket.AF_INET6 if bind == "::1" else socket.AF_INET
+    server = Server((bind, 0), Handler)
+    server.daemon_threads = True
+    thread = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": 0.02})
+    thread.start()
+    host = "[::1]" if bind == "::1" else bind
+    state["url"] = f"http://{host}:{server.server_port}/v1"
+    try:
+        yield state
+    finally:
+        state["closed"].set()
+        server.shutdown()
+        server.server_close()
+        thread.join(3)
+        assert not thread.is_alive()
