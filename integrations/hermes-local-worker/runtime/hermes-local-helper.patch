index 0000000000..8e9d8c67eb
--- /dev/null
+++ b/tests/agent/test_local_helper_inheritance.py
@@ -0,0 +1,162 @@
+"""Current real loader and plugin inheritance at the bounded helper boundary."""
+import asyncio
+import copy
+import json
+
+import pytest
+
+from agent import auxiliary_client as aux, qualified_local_helper as helper
+from hermes_cli import config, plugins
+from hermes_cli.config_read_errors import FailedConfigRead
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+MESSAGES = [{"role": "user", "content": "Offline fixture"}]
+POLICY = {"provider": "llama.cpp", "model": "offline-fixture",
+          "base_url": "http://127.0.0.1:1/v1", "fallback_enabled": False}
+
+
+@pytest.fixture
+def inherited_home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    token = set_hermes_home_override(home)
+    manager = plugins.PluginManager()
+    manager._discovered = True
+    monkeypatch.setattr(plugins, "_PLUGIN_MANAGER", manager, raising=False)
+    monkeypatch.setattr(plugins, "get_plugin_manager", lambda: manager)
+    monkeypatch.setattr(plugins, "_ensure_plugins_discovered", lambda: manager)
+    ctx = plugins.PluginContext(plugins.PluginManifest(name="offline"), manager)
+    ctx.register_auxiliary_task("ordinary_fixture", display_name="Ordinary", description="fixture",
+                                inherit_from="compression", defaults={"timeout": 9})
+    ctx.register_auxiliary_task("local_helper", display_name="Local", description="fixture",
+                                inherit_from="compression")
+    try:
+        yield home
+    finally:
+        reset_hermes_home_override(token)
+
+
+def write(home, value):
+    (home / "config.yaml").write_text(json.dumps(value), encoding="utf-8")
+
+
+def consume(mode):
+    if mode == "raw":
+        return aux.get_text_auxiliary_client("local_helper")
+    if mode == "async":
+        return asyncio.run(aux.async_call_llm(task="local_helper", messages=MESSAGES))
+    return aux.call_llm(task="local_helper", messages=MESSAGES)
+
+
+@pytest.mark.parametrize("mode", ["sync", "async", "raw"])
+@pytest.mark.parametrize("warm", [False, True])
+@pytest.mark.parametrize("bad", ["root", "auxiliary", "task", "syntax", "unreadable"])
+def test_inherited_helper_loader_failures_refuse_before_dispatch(inherited_home, monkeypatch, mode, warm, bad):
+    home = inherited_home
+    valid = {"auxiliary": {"compression": POLICY,
+                           "local_helper": {**POLICY, "model": "", "base_url": "", "provider": "auto"}}}
+    if warm:
+        write(home, valid)
+        assert helper.prepare_local_call("local_helper", messages=MESSAGES).model == "offline-fixture"
+    if bad == "syntax":
+        (home / "config.yaml").write_text("auxiliary: [\n", encoding="utf-8")
+    elif bad == "unreadable":
+        path = home / "config.yaml"
+        if path.exists():
+            path.unlink()
+        path.mkdir()
+    else:
+        write(home, {"root": [], "auxiliary": {"auxiliary": []},
+                     "task": {"auxiliary": {"compression": POLICY, "local_helper": []}}}[bad])
+    loaded = config.load_config_readonly()
+    if bad in {"root", "syntax", "unreadable"}:
+        assert isinstance(loaded, FailedConfigRead)
+    else:
+        assert not isinstance(loaded, FailedConfigRead)
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("malformed inheritance reached provider, credentials, Relay or local transport")
+
+    for name in ("_resolve_task_provider_model", "resolve_provider_client", "_get_cached_client",
+                 "_resolve_auto_route", "_scoped_key_env", "_try_payment_fallback",
+                 "_try_main_agent_model_fallback", "_call_llm_impl", "_async_call_llm_impl"):
+        # Raw resolution itself must run to exercise its FailedConfigRead consumer.
+        if name != "_resolve_task_provider_model" or mode != "raw":
+            monkeypatch.setattr(aux, name, forbidden)
+    monkeypatch.setattr(helper, "call_local", forbidden)
+    monkeypatch.setattr(helper, "acall_local", forbidden)
+    with pytest.raises(helper.LocalHelperError, match="policy cannot be read"):
+        consume(mode)
+    resolved = aux._get_auxiliary_task_config("local_helper")
+    assert isinstance(resolved, FailedConfigRead)
+    assert resolved.read_error is not None
+
+
+def test_non_helper_inheritance_preserves_read_time_and_atomic_route_pins(inherited_home):
+    home = inherited_home
+    base = {"provider": "custom", "model": "fixture/a", "base_url": "https://fixture.invalid",
+            "api_key": "synthetic-key", "extra_body": {"fixture": True}}
+    write(home, {"auxiliary": {"compression": base,
+                               "ordinary_fixture": {"provider": "auto", "model": "", "base_url": "",
+                                                    "api_key": "", "timeout": 4}}})
+    snapshot = copy.deepcopy(config.load_config_readonly())
+    result = aux._get_auxiliary_task_config("ordinary_fixture")
+    assert result["model"] == "fixture/a" and result["api_key"] == "synthetic-key"
+    assert result["timeout"] == 4 and result["extra_body"] == {"fixture": True}
+    assert config.load_config_readonly() == snapshot
+    write(home, {"auxiliary": {"compression": {**base, "model": "fixture/b"}}})
+    assert aux._get_auxiliary_task_config("ordinary_fixture")["model"] == "fixture/b"
+    write(home, {"auxiliary": {"compression": base,
+                               "ordinary_fixture": {"provider": "anthropic", "model": "fixture/pinned",
+                                                    "base_url": "", "api_key": ""}}})
+    result = aux._get_auxiliary_task_config("ordinary_fixture")
+    assert (result["provider"], result["model"]) == ("anthropic", "fixture/pinned")
+    assert not result.get("base_url") and not result.get("api_key")
+    assert result["timeout"] == 9
+
+
+@pytest.mark.parametrize("mode", ["sync", "async"])
+def test_selected_helper_inherits_literal_route_without_ordinary_dispatch(inherited_home, monkeypatch, mode):
+    write(inherited_home, {"auxiliary": {"compression": POLICY,
+                                         "local_helper": {"provider": "auto", "model": "", "base_url": "",
+                                                          "fallback_enabled": False}}})
+    snapshot = copy.deepcopy(config.load_config_readonly())
+    calls = []
+
+    def local(call, **kwargs):
+        calls.append(call)
+        return "offline-local"
+
+    async def alocal(call, **kwargs):
+        return local(call, **kwargs)
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("selected inherited helper reached ordinary dispatch")
+
+    monkeypatch.setattr(helper, "call_local", local)
+    monkeypatch.setattr(helper, "acall_local", alocal)
+    monkeypatch.setattr(aux, "_call_llm_impl", forbidden)
+    monkeypatch.setattr(aux, "_async_call_llm_impl", forbidden)
+    assert consume(mode) == "offline-local"
+    assert len(calls) == 1
+    assert calls[0].url == "http://127.0.0.1:1/v1/chat/completions"
+    assert json.loads(calls[0].payload) == {"model": "offline-fixture", "messages": MESSAGES, "max_tokens": 512}
+    assert config.load_config_readonly() == snapshot
+
+
+@pytest.mark.parametrize("value", [[], ["invalid"], "", "invalid", False, True, 0, 1])
+def test_wrong_shaped_raw_root_retains_failure_marker(inherited_home, value):
+    write(inherited_home, value)
+    assert isinstance(config.read_raw_config_readonly(), FailedConfigRead)
+    assert isinstance(config.load_config_readonly(), FailedConfigRead)
+    assert isinstance(aux._get_auxiliary_task_config("local_helper"), FailedConfigRead)
+    # The ordinary auxiliary resolver keeps the existing readable fallback mapping.
+    assert not isinstance(aux._get_auxiliary_task_config("compression"), FailedConfigRead)
+
+
+@pytest.mark.parametrize("content", ["", "null\n", "{}\n"])
+def test_blank_null_mapping_roots_keep_ordinary_defaults(inherited_home, content):
+    (inherited_home / "config.yaml").write_text(content, encoding="utf-8")
+    assert not isinstance(config.read_raw_config_readonly(), FailedConfigRead)
+    assert not isinstance(config.load_config_readonly(), FailedConfigRead)
+    assert aux._get_auxiliary_task_config("compression")["provider"] == "auto"
