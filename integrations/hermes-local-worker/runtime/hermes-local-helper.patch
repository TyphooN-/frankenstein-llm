+"""Real-loader shape refusals; downstream seams are offline sentinels only."""
+import asyncio
+import json
+import socket
+
+import pytest
+
+from agent import auxiliary_client as aux, qualified_local_helper as helper, secret_scope
+from hermes_cli import config
+from hermes_cli.config_read_errors import FailedConfigRead
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+TASKS = ("title_generation", "profile_describer", "local_helper")
+SHAPES = [[], ["broken"], "", "broken", False, True, 0, 1, 1.5]
+MESSAGES = [{"role": "user", "content": "Offline synthetic text"}]
+POLICY = {"provider": "llama.cpp", "model": "offline-fixture",
+          "base_url": "http://127.0.0.1:1/v1", "fallback_enabled": False}
+
+
+@pytest.fixture
+def offline_seams(monkeypatch):
+    seen = []
+
+    def ordinary(**kwargs):
+        seen.append(("sync", kwargs["task"]))
+        return "ordinary"
+
+    async def async_ordinary(**kwargs):
+        seen.append(("async", kwargs["task"]))
+        return "ordinary"
+
+    def provider(provider, **kwargs):
+        seen.append(("raw", provider))
+        return "ordinary", "offline-fixture"
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("shape validation reached transport, credentials or fallback")
+
+    monkeypatch.setattr(aux, "_call_llm_impl", ordinary)
+    monkeypatch.setattr(aux, "_async_call_llm_impl", async_ordinary)
+    monkeypatch.setattr(aux, "resolve_provider_client", provider)
+    for name in ("_get_cached_client", "_resolve_auto_route", "_scoped_key_env",
+                 "_try_payment_fallback", "_try_main_agent_model_fallback"):
+        monkeypatch.setattr(aux, name, forbidden)
+    monkeypatch.setattr(helper, "call_local", forbidden)
+    monkeypatch.setattr(helper, "acall_local", forbidden)
+    monkeypatch.setattr(socket, "create_connection", forbidden)
+    monkeypatch.setattr(secret_scope, "get_secret", forbidden)
+    aux._reset_aux_semaphores()
+    yield seen
+    aux._reset_aux_semaphores()
+
+
+def consume(task, mode):
+    if mode == "raw":
+        return aux.get_text_auxiliary_client(task)[0]
+    if mode == "async":
+        return asyncio.run(aux.async_call_llm(task=task, messages=MESSAGES))
+    return aux.call_llm(task=task, messages=MESSAGES)
+
+
+def write(home, value):
+    home.mkdir(parents=True, exist_ok=True)
+    (home / "config.yaml").write_text(json.dumps(value))
+
+
+@pytest.mark.parametrize("task", TASKS)
+@pytest.mark.parametrize("level", ["auxiliary", "task"])
+@pytest.mark.parametrize("shape", SHAPES)
+@pytest.mark.parametrize("warm", [False, True])
+@pytest.mark.parametrize("mode", ["sync", "async", "raw"])
+def test_real_loader_malformed_shapes_refuse_a_b_a(tmp_path, offline_seams, task, level, shape, warm, mode):
+    homes = [tmp_path / "a", tmp_path / "b"]
+    if warm:
+        write(homes[0], {"auxiliary": {task: POLICY}})
+        token = set_hermes_home_override(homes[0])
+        try:
+            assert helper.prepare_local_call(task, messages=MESSAGES) is not None
+        finally:
+            reset_hermes_home_override(token)
+    invalid = {"auxiliary": shape if level == "auxiliary" else {task: shape}}
+    write(homes[0], invalid)
+    write(homes[1], {})
+    previous = secret_scope._MULTIPLEX_ACTIVE
+    secret_scope.set_multiplex_active(True)
+    try:
+        for home in (homes[0], homes[1], homes[0]):
+            token = set_hermes_home_override(home)
+            try:
+                if home == homes[1]:
+                    # B must not inherit A's malformed policy or a historical latch.
+                    cfg = aux._get_auxiliary_task_config(task)
+                    assert not isinstance(cfg, FailedConfigRead)
+                    assert cfg["fallback_enabled"] is True
+                    if task == "local_helper" and mode != "raw":
+                        with pytest.raises(helper.LocalHelperError, match="requires explicit"):
+                            consume(task, mode)
+                    else:
+                        assert consume(task, mode) == "ordinary"
+                    offline_seams.clear()
+                    continue
+                loaded = config.load_config_readonly()
+                assert not isinstance(loaded, FailedConfigRead), "exercise valid YAML, not syntax failure"
+                value = loaded["auxiliary"] if level == "auxiliary" else loaded["auxiliary"][task]
+                assert type(value) is type(shape) and value == shape
+                # Public consumers must refuse, not merely produce a config marker.
+                with pytest.raises(helper.LocalHelperError, match="policy cannot be read"):
+                    consume(task, mode)
+                assert offline_seams == []
+                task_cfg = aux._get_auxiliary_task_config(task)
+                assert isinstance(task_cfg, FailedConfigRead)
+                assert isinstance(task_cfg.read_error, TypeError)
+            finally:
+                reset_hermes_home_override(token)
+    finally:
+        secret_scope.set_multiplex_active(previous)
+
+
+@pytest.mark.parametrize("task", [*TASKS, "oneshot", "compression", "plugin-fixture"])
+@pytest.mark.parametrize("mode", ["sync", "async", "raw"])
+@pytest.mark.parametrize("form", ["absent-file", "empty-file", "absent", "aux-empty", "task-empty",
+                                  "aux-null", "task-null", "aux-blank", "task-blank", "fallback-true",
+                                  "other-task-malformed", "aux-malformed-unguarded", "task-malformed-unguarded"])
+def test_real_loader_shape_defaults_preserve_ordinary_contract(tmp_path, offline_seams, task, mode, form):
+    home = tmp_path / "defaults"
+    home.mkdir()
+    path = home / "config.yaml"
+    values = {"absent": {}, "aux-empty": {"auxiliary": {}},
+              "task-empty": {"auxiliary": {task: {}}}, "aux-null": {"auxiliary": None},
+              "task-null": {"auxiliary": {task: None}},
+              "fallback-true": {"auxiliary": {task: {"fallback_enabled": True}}},
+              "other-task-malformed": {"auxiliary": {"unrelated-fixture": []}},
+              "aux-malformed-unguarded": {"auxiliary": []},
+              "task-malformed-unguarded": {"auxiliary": {task: "broken"}}}
+    if form.endswith("unguarded") and task in TASKS:
+        pytest.skip("guarded shape refusals are covered by the malformed matrix")
+    raw_forms = {"empty-file": "", "aux-blank": "auxiliary:\n", "task-blank": f"auxiliary:\n  {task}:\n"}
+    if form != "absent-file":
+        content = raw_forms[form] if form in raw_forms else json.dumps(values[form])
+        path.write_text(content)
+    token = set_hermes_home_override(home)
+    try:
+        assert not isinstance(aux._get_auxiliary_task_config(task), FailedConfigRead)
+        if task == "local_helper" and mode != "raw":
+            with pytest.raises(helper.LocalHelperError, match="requires explicit"):
+                consume(task, mode)
+            assert not offline_seams
+        else:
+            assert consume(task, mode) == "ordinary"
+            assert len(offline_seams) == 1
+    finally:
+        reset_hermes_home_override(token)
