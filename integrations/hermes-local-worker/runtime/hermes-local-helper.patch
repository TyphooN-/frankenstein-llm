+"""Independent acceptance: observers cannot expand the helper deadline.
+
+No endpoint is launched or contacted. An actual registered observer returns
+normally after 3 seconds; the configured helper budget is 1 second. Production
+hooks/config/wrapper code is used, not a mocked hook runner or transport.
+"""
+import asyncio
+import json
+import threading
+import time
+
+import pytest
+
+from agent import auxiliary_client as aux
+from hermes_cli import plugins
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+from hermes_constants import get_hermes_home
+
+
+@pytest.mark.parametrize('mode', ['sync','async'])
+def test_registered_observer_cannot_extend_absolute_local_deadline(monkeypatch, mode):
+    home = get_hermes_home()
+    policy = {'provider':'llama.cpp','model':'offline-fixture',
+              'base_url':'http://127.0.0.1:1/v1','fallback_enabled':False,
+              'local_helper_caps':{'timeout':1.0},'max_concurrency':1}
+    (home/'config.yaml').write_text(json.dumps({'auxiliary':{'local_helper':policy}}))
+    manager = PluginManager()
+    manager._discovered = True
+    monkeypatch.setattr(plugins,'_plugin_manager',manager)
+    monkeypatch.setattr(plugins,'_plugin_managers_by_home',{})
+    monkeypatch.setattr(plugins,'get_plugin_manager',lambda:manager)
+    monkeypatch.setattr(plugins,'_ensure_plugins_discovered',lambda:manager)
+    ctx = PluginContext(PluginManifest(name='independent-offline-observer'),manager)
+    finished = threading.Event()
+    observations = []
+
+    def observer(**kwargs):
+        observations.append(kwargs['aux_task'])
+        time.sleep(3.0)
+        finished.set()
+
+    ctx.register_hook('pre_auxiliary_call',observer)
+
+    def forbidden(*args, **kwargs):
+        pytest.fail('helper reached generic provider, credential, fallback or Relay dispatch')
+
+    for name in ('_resolve_task_provider_model','resolve_provider_client','_get_cached_client',
+                 '_resolve_auto_route','_scoped_key_env','_try_payment_fallback',
+                 '_try_main_agent_model_fallback','_call_llm_impl','_async_call_llm_impl'):
+        monkeypatch.setattr(aux,name,forbidden)
+    from agent import relay_llm, secret_scope
+    monkeypatch.setattr(relay_llm,'execute_current',forbidden)
+    monkeypatch.setattr(relay_llm,'execute_current_async',forbidden)
+    monkeypatch.setattr(secret_scope,'get_secret',forbidden)
+    started = time.monotonic()
+    try:
+        with pytest.raises(TimeoutError):
+            request = dict(task='local_helper',messages=[{'role':'user','content':'offline synthetic text'}])
+            if mode == 'async':
+                asyncio.run(aux.async_call_llm(**request))
+            else:
+                aux.call_llm(**request)
+        elapsed = time.monotonic()-started
+        print(json.dumps({'mode':mode,'configured_deadline_seconds':1.0,
+                          'observer_delay_seconds':3.0,'elapsed_seconds':elapsed,
+                          'observer_finished_at_return':finished.is_set(),
+                          'observed_tasks':observations,'network_dispatch_permitted':False}),flush=True)
+        assert elapsed < 2.0, 'registered observer expanded the absolute helper deadline'
+    finally:
+        # Bound cleanup even if a future executor repairs the deadline path.
+        assert finished.wait(4.0), 'bounded observer did not finish'
+        aux._reset_aux_semaphores()
