diff --git a/agent/local_helper_observers.py b/agent/local_helper_observers.py
new file mode 100644
index 0000000000..1122442d33
--- /dev/null
+++ b/agent/local_helper_observers.py
@@ -0,0 +1,149 @@
+"""Deadline-aware observer delivery ONLY for qualified local text helpers.
+
+Four process-wide delivery slots; queued envelopes retain admission until consumed.
+Python callbacks cannot be killed: expired/cancelled envelopes stop between
+subscribers, and a running subscriber keeps its slot until it actually exits.
+Saturation drops notifications, not transport. Daemon workers never join at
+process exit. Ordinary auxiliary hooks retain their existing dispatch contract.
+"""
+from __future__ import annotations
+
+import asyncio
+import contextvars
+import copy
+import logging
+import threading
+import time
+from concurrent.futures import Future
+
+from agent.auxiliary_hooks import _AuxCallHooks
+from hermes_constants import set_hermes_home_override
+from tools.daemon_pool import DaemonThreadPoolExecutor
+
+logger = logging.getLogger(__name__)
+_MAX_DELIVERIES = 4
+_slots = threading.BoundedSemaphore(_MAX_DELIVERIES)
+_executor = DaemonThreadPoolExecutor(max_workers=_MAX_DELIVERIES, thread_name_prefix="local-helper-observer")
+
+
+def _profile_context(home):
+    # Do not copy the caller's live turn, cancellation closures, runtime provider,
+    # or arbitrary task ContextVars: these can retain its loop and full prompt.
+    # Turn/request identity is a value snapshot in the standard event payload.
+    from agent.secret_scope import _MULTIPLEX_CONTEXT, _SECRET_SCOPE
+
+    context = contextvars.Context()
+    context.run(set_hermes_home_override, home)
+    context.run(_MULTIPLEX_CONTEXT.set, _MULTIPLEX_CONTEXT.get())
+    context.run(_SECRET_SCOPE.set, _SECRET_SCOPE.get())
+    return context
+
+
+def _deliver(name, payload, deadline, stopped):
+    from hermes_cli import lifecycle, plugins
+    from hermes_cli.middleware import OBSERVER_SCHEMA_VERSION
+
+    def expired():
+        return stopped.is_set() or time.monotonic() >= deadline
+
+    if expired():
+        return
+    lifecycle._observe(name, **copy.deepcopy(payload))
+    if expired():
+        return
+    # Discovery and all user callbacks stay off the caller/event loop. Do not
+    # invoke the ordinary timeout dispatcher here: that spawns nested workers.
+    manager = plugins._delivery_manager()
+    payload.setdefault("telemetry_schema_version", OBSERVER_SCHEMA_VERSION)
+    for callback in manager.iter_hook_callbacks(name):
+        if expired():
+            break
+        try:
+            manager._invoke_hook_callback(callback, copy.deepcopy(payload))
+        except BaseException:
+            # No retained traceback/result: observers cannot veto local work.
+            logger.warning("%s local helper observer failed; continuing", name, exc_info=True)
+
+
+def _run_delivery(*args, slot):
+    try:
+        _deliver(*args)
+    except BaseException:
+        logger.warning("local helper observer delivery failed; continuing", exc_info=True)
+    finally:
+        slot.release()
+
+
+def _submit(name, payload, home, deadline):
+    slot = _slots
+    if time.monotonic() >= deadline or not slot.acquire(blocking=False):
+        logger.debug("%s local helper notification dropped (deadline or saturation)", name)
+        return None
+    stopped = threading.Event()
+    try:
+        future = _profile_context(home).run(_executor.submit, _run_delivery, name, copy.deepcopy(payload), deadline, stopped, slot=slot)
+    except Exception:
+        # Executor submission can fail AFTER enqueue (e.g. thread-start failure).
+        # Only actual consumption can release the slot without unbounded queued
+        # tombstones. A pre-enqueue failure conservatively loses one slot until
+        # process restart; notifications fail open and transport remains usable.
+        stopped.set()
+        logger.warning("%s local helper notification could not be scheduled", name, exc_info=True)
+        return None
+    return future, stopped
+
+
+class LocalObserverHooks:
+    """Copied payloads, bounded waits, and no caller-loop references in workers."""
+
+    def __init__(self, home, deadline, **kwargs):
+        self.home = home
+        self.deadline = deadline
+        self.pending: tuple[Future, threading.Event] | None = None
+        self.hooks = _AuxCallHooks(**kwargs, streaming=False, emit=self._emit, consumes=lambda _: True)
+
+    def _emit(self, name, **payload):
+        self.pending = _submit(name, payload, self.home, self.deadline)
+
+    def notify(self, *, response=None, error=None, pre=False):
+        self.pending = None
+        try:
+            if pre:
+                self.hooks.pre()
+            else:
+                self.hooks.post(response, error)
+        except Exception:
+            logger.warning("local helper observer payload failed; continuing", exc_info=True)
+
+    def abandon(self):
+        if self.pending is not None:
+            _, stopped = self.pending
+            stopped.set()
+            # Future.cancel leaves its WorkItem/payload in the executor queue.
+            # Let the worker consume the stopped envelope and release admission.
+            self.pending = None
+
+    def wait(self, remaining):
+        if self.pending is None:
+            return
+        future, _ = self.pending
+        sleeper = threading.Event()
+        try:
+            while not future.done():
+                # Event.wait avoids a retained Future exception/traceback and
+                # polls host cancellation with the same quantum as transport.
+                sleeper.wait(min(0.05, remaining()))
+            remaining()
+        finally:
+            self.abandon()
+
+    async def await_delivery(self, remaining):
+        if self.pending is None:
+            return
+        future, _ = self.pending
+        try:
+            while not future.done():
+                await asyncio.sleep(min(0.01, remaining()))
+            remaining()
+        finally:
+            self.abandon()
