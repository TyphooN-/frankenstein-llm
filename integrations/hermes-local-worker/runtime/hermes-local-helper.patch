+"""Offline subprocess proof of the tool-free helper entry point."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+pytest_plugins = ["tests.agent.test_qualified_local_helper"]
+
+from hermes_constants import get_hermes_home
+from tests.agent.test_qualified_local_helper import (
+    assert_wire, completion, configure,
+)
+
+
+def run_script(tmp_path, text: str | bytes = "Cache was invalidated twice", instruction="Summarize the supplied note"):
+    return subprocess.run(
+        [sys.executable, str(Path(__file__).resolve().parents[2] / "scripts/local_helper.py"),
+         "--instruction", instruction], input=text, text=not isinstance(text, bytes), capture_output=True,
+        env={"HOME": str(tmp_path), "HERMES_HOME": str(get_hermes_home()),
+             "PATH": os.defpath, "OPENAI_API_KEY": "offline-cloud-sentinel",
+             "PYTHONIOENCODING": "utf-8:strict"}, timeout=5,
+    )
+
+
+def test_tool_free_script_entrypoint(loopback, tmp_path):
+    configure(loopback, task="local_helper")
+    loopback["payload"] = completion("Cache fix summary")
+    result = run_script(tmp_path)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.strip() == "Cache fix summary"
+    assert_wire(loopback)
+
+
+def test_unconfigured_script_never_discovers_cloud(loopback, tmp_path):
+    result = run_script(tmp_path)
+    assert result.returncode == 1
+    assert "LocalHelperError" in result.stderr
+    assert not loopback["requests"]
+    assert not result.stdout
+
+
+@pytest.mark.parametrize("text,instruction", [("", "summarize"), ("x" * 32769, "summarize"),
+                                              ("note", "x" * 4097), ("note", "")])
+def test_script_refuses_unbounded_or_empty_input(loopback, tmp_path, text, instruction):
+    configure(loopback, task="local_helper")
+    result = run_script(tmp_path, text, instruction)
+    assert result.returncode == 2
+    assert not loopback["requests"]
+    assert not result.stdout
+
+
+@pytest.mark.parametrize("content", [
+    "Summary\x1b]52;c;bm90ZS10ZXh0\x07", "Summary\x1b[2J", "Summary\x9b2J", "Summary\ud83d",
+])
+def test_script_escapes_untrusted_terminal_controls(loopback, tmp_path, content):
+    configure(loopback, task="local_helper")
+    loopback["payload"] = completion(content)
+    result = run_script(tmp_path)
+    assert result.returncode == 0, result.stderr
+    assert all(character in "\n\t" or (
+        ord(character) >= 32 and not 127 <= ord(character) <= 159
+        and not 0xD800 <= ord(character) <= 0xDFFF) for character in result.stdout)
+    assert "\\u" in result.stdout
+    assert not result.stderr
+    assert_wire(loopback)
+
+
+def test_invalid_utf8_stdin_has_controlled_failure(loopback, tmp_path):
+    configure(loopback, task="local_helper")
+    result = run_script(tmp_path, text=b"invalid UTF-8: \xff")
+    assert result.returncode == 1
+    assert b"UnicodeDecodeError" in result.stderr
+    assert b"Traceback" not in result.stderr
+    assert not result.stdout
+    assert not loopback["requests"]
