+@pytest.mark.platforms("posix")
+def test_real_title_entrypoint_handles_high_socket_fd(loopback):
+    import resource
+    from agent.title_generator import generate_title
+
+    soft_limit, _ = resource.getrlimit(resource.RLIMIT_NOFILE)
+    if soft_limit <= 1150:
+        pytest.skip("requires an existing file descriptor limit above 1150")
+    configure(loopback)
+    descriptors = []
+    try:
+        while not descriptors or descriptors[-1] < 1100:
+            descriptors.append(os.open(os.devnull, os.O_RDONLY))
+        errors = []
+        assert generate_title("Repair cache invalidation", failure_callback=lambda *e: errors.append(e)) == "Repair cache invalidation", errors
+        assert not errors
+        assert_wire(loopback)
+    finally:
+        for descriptor in descriptors:
+            os.close(descriptor)
+
+
+@pytest.mark.parametrize("entrypoint", ["api", "rpc"])
+def test_default_oneshot_is_not_captured_by_local_title_policy(loopback, monkeypatch, entrypoint):
+    configure(loopback)
+    seen = []
+
+    def ordinary_call(**kwargs):
+        seen.append(kwargs)
+        message = SimpleNamespace(content="fix: repair cache", reasoning=None,
+                                  reasoning_content=None, reasoning_details=None)
+        return SimpleNamespace(choices=[SimpleNamespace(message=message)])
+
+    # Never make an upstream request. Exercise the real public routing wrapper
+    # and entrypoint while replacing only the ordinary implementation seam.
+    monkeypatch.setattr(aux, "_call_llm_impl", ordinary_call)
+    if entrypoint == "api":
+        from agent.oneshot import run_oneshot
+        assert run_oneshot(instructions="Write a commit message", user_input="Repair cache") == "fix: repair cache"
+    else:
+        from tui_gateway import server
+        result = server._methods["llm.oneshot"]("review-regression", {
+            "instructions": "Write a commit message", "input": "Repair cache",
+        })
+        assert result.get("result", {}).get("text") == "fix: repair cache", result
+    assert len(seen) == 1
+    assert seen[0]["task"] == "oneshot"
+    assert seen[0]["max_tokens"] == 1024
+    assert seen[0]["temperature"] == 0.3
+    assert seen[0]["timeout"] == 60.0
+    assert not loopback["requests"]
