+"""Strict wire-number decoding, not model qualification."""
+import json
+
+import pytest
+
+from agent.qualified_local_helper import LocalHelperError
+from tests.agent.test_qualified_local_helper import assert_wire, completion, configure, invoke
+
+pytest_plugins = ["tests.agent.test_qualified_local_helper"]
+
+
+@pytest.mark.parametrize("mode", ["sync", "async"])
+@pytest.mark.parametrize("number", ["1e999", "-1e999", "NaN", "Infinity", "-Infinity"])
+def test_nonfinite_wire_numbers_are_refused(loopback, mode, number):
+    configure(loopback)
+    raw = json.dumps(completion()).removesuffix("}")
+    loopback["raw"] = (raw + ', "metadata": {"nested": [' + number + "]}}").encode()
+    with pytest.raises(LocalHelperError, match="invalid, refused or oversized"):
+        invoke(mode)
+    assert_wire(loopback)
+    assert len(loopback["requests"]) == 1
+
+
+@pytest.mark.parametrize("mode", ["sync", "async"])
+def test_finite_numbers_and_numeric_strings_remain_valid(loopback, mode):
+    configure(loopback)
+    loopback["payload"]["metadata"] = {"nested": [1.25, "1e999", "Infinity"]}
+    assert invoke(mode).choices[0].message.content
+    assert_wire(loopback)
