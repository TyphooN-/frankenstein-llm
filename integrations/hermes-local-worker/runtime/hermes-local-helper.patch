+"""Current-base helper admission and ordinary gateway-envelope coexistence."""
+from types import SimpleNamespace
+
+import pytest
+
+from agent import auxiliary_client as aux
+
+
+def test_malformed_title_policy_refuses_before_ordinary_dispatch(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(
+        "auxiliary:\n  title_generation: []\n", encoding="utf-8"
+    )
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("malformed policy reached ordinary provider dispatch")
+
+    monkeypatch.setattr(aux, "resolve_provider_client", forbidden)
+    monkeypatch.setattr(aux, "_get_cached_client", forbidden)
+    monkeypatch.setattr(aux, "_resolve_auto_route", forbidden)
+    monkeypatch.setattr(aux, "_scoped_key_env", forbidden)
+    with pytest.raises(RuntimeError, match="policy cannot be read"):
+        aux.get_text_auxiliary_client("title_generation")
+
+
+def test_ordinary_title_policy_preserves_upstream_data_envelope(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(
+        "auxiliary:\n  title_generation:\n    fallback_enabled: true\n",
+        encoding="utf-8",
+    )
+    response = SimpleNamespace(
+        choices=None,
+        success=True,
+        data={
+            "model": "offline-ordinary",
+            "choices": [{"message": {"role": "assistant", "content": "offline title"}}],
+        },
+    )
+
+    def ordinary(**kwargs):
+        return aux._validate_llm_response(response, kwargs["task"])
+
+    monkeypatch.setattr(aux, "_call_llm_impl", ordinary)
+    result = aux.call_llm(
+        task="title_generation", messages=[{"role": "user", "content": "offline input"}]
+    )
+    assert result.choices[0].message.content == "offline title"
+    assert result.model == "offline-ordinary"
diff --git a/tests/agent/test_local_helper_inheritance.py b/tests/agent/test_local_helper_inheritance.py
