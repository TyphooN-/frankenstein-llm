@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""One bounded, tool-free local text request; no inference until explicitly invoked.
+
+Use only after the supervising parent qualifies and pins auxiliary.local_helper.
+Returned text is untrusted; this is not an approval or security-review agent.
+"""
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import sys
+
+# Match other standalone repository scripts, without loading CLI credentials.
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+
+def _terminal_text(text: str) -> str:
+    """Render untrusted controls as visible escapes, not terminal commands."""
+    return "".join(f"\\u{ord(character):04x}" if (
+        character not in "\n\t" and (ord(character) < 32 or 127 <= ord(character) <= 159
+                                    or 0xD800 <= ord(character) <= 0xDFFF))
+        else character for character in text)
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--instruction", required=True, help="Bounded text transformation instruction")
+    args = parser.parse_args(argv)
+    if not 1 <= len(args.instruction) <= 4096:
+        parser.error("instruction must contain 1–4096 characters")
+    try:
+        text = sys.stdin.read(32769)
+        if not text.strip() or len(text) > 32768:
+            parser.error("stdin must contain 1–32768 characters")
+        from agent.auxiliary_client import call_llm
+        response = call_llm(task="local_helper", messages=[
+            {"role": "system", "content": args.instruction}, {"role": "user", "content": text},
+        ])
+        print(_terminal_text(response.choices[0].message.content), flush=True)
+    except Exception as exc:  # health: allow BLE001 -- CLI boundary sanitizes every failure without leaking input or provider errors
+        # Do not echo provider errors, credentials, or supplied data into logs.
+        print(f"Local helper failed ({type(exc).__name__}); check the explicit local policy.", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
