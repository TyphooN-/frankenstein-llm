@@ -0,0 +1,281 @@
+"""Offline behavioral controls for the corrected local observer scheduler.
+
+These are protocol/lifetime regressions, not independent acceptance or inference.
+Use actual registered callbacks and the maintained loopback fixture.
+"""
+from __future__ import annotations
+
+import asyncio
+import contextvars
+import gc
+import threading
+import time
+import weakref
+
+import pytest
+
+from agent import auxiliary_client as aux
+from agent import local_helper_observers as observers
+from hermes_cli import plugins
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+from hermes_constants import get_hermes_home
+from tests.agent.test_qualified_local_helper import assert_wire, configure, invoke
+
+pytest_plugins = ("tests.agent.test_qualified_local_helper",)
+
+
+@pytest.fixture
+def subscriber(monkeypatch):
+    manager = PluginManager()
+    manager._discovered = True
+    monkeypatch.setattr(plugins, "_plugin_manager", manager)
+    monkeypatch.setattr(plugins, "_plugin_managers_by_home", {})
+    monkeypatch.setattr(plugins, "get_plugin_manager", lambda: manager)
+    monkeypatch.setattr(plugins, "_ensure_plugins_discovered", lambda: manager)
+    return PluginContext(PluginManifest(name="offline-observer-controls"), manager)
+
+
+def bounded_blocker(entered, release, finished):
+    def callback(**kwargs):
+        entered.set()
+        try:
+            release.wait(3)
+        finally:
+            finished.set()
+    return callback
+
+
+@pytest.mark.parametrize("mode", ["sync", "async"])
+def test_slow_post_observer_shares_the_absolute_deadline(loopback, subscriber, mode):
+    configure(loopback, local_helper_caps={"timeout": 0.8})
+    entered, release, finished = (threading.Event() for _ in range(3))
+    subscriber.register_hook("post_auxiliary_call", bounded_blocker(entered, release, finished))
+    started = time.monotonic()
+    try:
+        with pytest.raises(TimeoutError):
+            invoke(mode)
+        assert time.monotonic() - started < 2, "post observer expanded the caller deadline"
+        assert entered.is_set()
+        assert_wire(loopback)
+    finally:
+        release.set()
+        assert finished.wait(2), "controlled observer was not cleaned up"
+
+
+@pytest.mark.parametrize("mode", ["sync", "async"])
+def test_registered_observers_cannot_mutate_the_wire_or_each_other(loopback, subscriber, mode):
+    configure(loopback)
+    seen = []
+    post_seen = []
+    expected_home = get_hermes_home()
+
+    def mutator(**payload):
+        payload["request"]["body"]["model"] = "observer-poison"
+        payload["request_messages"][0]["content"] = "observer-poison"
+
+    def witness(**payload):
+        seen.append((get_hermes_home(), payload["api_request_id"],
+                     payload["request"]["body"]["model"],
+                     payload["request_messages"][0]["content"]))
+
+    def post_witness(**payload):
+        post_seen.append((get_hermes_home(), payload["api_request_id"]))
+
+    subscriber.register_hook("pre_auxiliary_call", mutator)
+    subscriber.register_hook("pre_auxiliary_call", witness)
+    subscriber.register_hook("post_auxiliary_call", post_witness)
+    outer = {"request_id": "offline-parent-request"}
+    token = aux._RELAY_AUX_CALL_CONTEXT.set(outer)
+    try:
+        assert invoke(mode).choices[0].message.content
+        assert aux._RELAY_AUX_CALL_CONTEXT.get() is outer
+    finally:
+        aux._RELAY_AUX_CALL_CONTEXT.reset(token)
+    assert len(seen) == 1
+    home, request_id, model, content = seen[0]
+    assert (home, model, content) == (expected_home, "fixture-model", "Name cache fix")
+    assert isinstance(request_id, str) and request_id
+    assert post_seen == [(expected_home, request_id)]
+    assert_wire(loopback)
+    assert loopback["requests"][0][2]["messages"][0]["content"] == "Name cache fix"
+
+
+@pytest.mark.parametrize("mode", ["sync", "async"])
+def test_failing_registered_observers_do_not_veto_transport(loopback, subscriber, mode):
+    configure(loopback)
+    seen = []
+
+    def pre(**payload):
+        seen.append("pre")
+        raise ValueError("controlled observer failure")
+
+    def post(**payload):
+        seen.append("post")
+        raise ValueError("controlled observer failure")
+
+    subscriber.register_hook("pre_auxiliary_call", pre)
+    subscriber.register_hook("post_auxiliary_call", post)
+    assert invoke(mode).choices[0].message.content
+    assert seen == ["pre", "post"]
+    assert_wire(loopback)
+
+
+@pytest.mark.parametrize("cause", ["native", "host"])
+def test_cancellation_during_observers_releases_the_helper_permit(loopback, subscriber, cause):
+    configure(loopback, local_helper_caps={"timeout": 5})
+    entered, release, finished = (threading.Event() for _ in range(3))
+    host_cancel = threading.Event()
+    subscriber.register_hook("pre_auxiliary_call", bounded_blocker(entered, release, finished))
+
+    async def run():
+        with aux.aux_interrupt_protection(cancel_event=host_cancel):
+            task = asyncio.create_task(aux.async_call_llm(
+                task="title_generation", messages=[{"role": "user", "content": "cancel me"}]))
+            end = time.monotonic() + 2
+            # A scheduled event-loop heartbeat must run while the callback waits.
+            while not entered.is_set():
+                assert time.monotonic() < end, "observer never started"
+                await asyncio.sleep(0.01)
+            started = time.monotonic()
+            if cause == "native":
+                task.cancel()
+                expected = asyncio.CancelledError
+            else:
+                host_cancel.set()
+                expected = aux.AuxiliaryExplicitCancellation
+            try:
+                with pytest.raises(expected):
+                    await task
+                assert time.monotonic() - started < 2
+                assert not loopback["requests"], "cancelled pre-observer dispatched transport"
+            finally:
+                release.set()
+                if not task.done():
+                    task.cancel()
+                    with pytest.raises(asyncio.CancelledError):
+                        await task
+        host_cancel.clear()
+        # Same loop, task and concurrency-one profile: a leaked permit stalls this.
+        assert (await aux.async_call_llm(
+            task="title_generation", messages=[{"role": "user", "content": "recover"}])).choices[0].message.content
+
+    try:
+        asyncio.run(run())
+        assert_wire(loopback)
+    finally:
+        release.set()
+        assert finished.wait(2)
+
+
+def test_saturation_drops_observers_without_queueing_or_blocking_transport(loopback, subscriber):
+    configure(loopback)
+    condition = threading.Condition()
+    release = threading.Event()
+    entered = []
+
+    def observer(**payload):
+        with condition:
+            entered.append(payload.get("api_request_id"))
+            condition.notify_all()
+        release.wait(3)
+
+    subscriber.register_hook("pre_auxiliary_call", observer)
+    pending = []
+    try:
+        for index in range(observers._MAX_DELIVERIES):
+            delivery = observers._submit("pre_auxiliary_call",
+                {"api_request_id": f"saturation-{index}"}, get_hermes_home(), time.monotonic() + 5)
+            assert delivery is not None
+            pending.append(delivery)
+        with condition:
+            assert condition.wait_for(lambda: len(entered) == observers._MAX_DELIVERIES, timeout=2)
+        assert observers._submit("pre_auxiliary_call", {}, get_hermes_home(), time.monotonic() + 5) is None
+        assert invoke().choices[0].message.content
+        assert_wire(loopback)
+        assert len(entered) == observers._MAX_DELIVERIES
+    finally:
+        release.set()
+        for future, _ in pending:
+            future.result(timeout=2)
+
+
+def test_observer_workers_do_not_inherit_arbitrary_caller_context(subscriber):
+    class CallerState:
+        pass
+
+    variable: contextvars.ContextVar[CallerState | None] = contextvars.ContextVar(
+        "offline-unrelated-caller-state", default=None)
+    state = CallerState()
+    reference = weakref.ref(state)
+    token = variable.set(state)
+    entered, release, finished = (threading.Event() for _ in range(3))
+    seen = []
+
+    def observer(**payload):
+        seen.append(variable.get())
+        entered.set()
+        try:
+            release.wait(3)
+        finally:
+            finished.set()
+
+    subscriber.register_hook("pre_auxiliary_call", observer)
+    pending = None
+    try:
+        pending = observers._submit("pre_auxiliary_call", {}, get_hermes_home(), time.monotonic() + 5)
+        assert pending is not None
+        assert entered.wait(2)
+        variable.reset(token)
+        token = None
+        del state
+        gc.collect()
+        assert seen == [None]
+        assert reference() is None, "running observer retained arbitrary caller state"
+    finally:
+        if token is not None:
+            variable.reset(token)
+        release.set()
+        assert finished.wait(2)
+        if pending is not None:
+            pending[0].result(timeout=2)
+
+
+@pytest.mark.parametrize("phase", ["abandon", "submit_exception"])
+def test_abandoned_queued_envelopes_keep_capacity_until_consumed(monkeypatch, phase):
+    """Cancellation must not turn the executor queue into unbounded tombstones."""
+    from tools.daemon_pool import DaemonThreadPoolExecutor
+
+    release = threading.Event()
+    # Deterministically delay dequeue, as a stalled/scheduling-delayed worker can.
+    pool = DaemonThreadPoolExecutor(max_workers=observers._MAX_DELIVERIES,
+                                  initializer=lambda: release.wait(5))
+    monkeypatch.setattr(observers, "_executor", pool)
+    monkeypatch.setattr(observers, "_slots", threading.BoundedSemaphore(observers._MAX_DELIVERIES))
+    adjustment = pool._adjust_thread_count
+
+    def failed_start():
+        raise RuntimeError("controlled failure after enqueue, before thread start")
+
+    if phase == "submit_exception":
+        monkeypatch.setattr(pool, "_adjust_thread_count", failed_start)
+    try:
+        for _ in range(observers._MAX_DELIVERIES * 8):
+            hooks = observers.LocalObserverHooks(get_hermes_home(), time.monotonic() + 10,
+                aux_task="local_helper", metadata={}, client=None, kwargs={},
+                provider="llama.cpp", model="fixture-model", api_mode="chat_completions")
+            hooks.notify(pre=True)
+            hooks.abandon()
+        queued = pool._work_queue.qsize()
+        assert queued <= observers._MAX_DELIVERIES, (
+            f"abandoned envelopes retained {queued} queued payloads for "
+            f"{observers._MAX_DELIVERIES} slots")
+    finally:
+        release.set()
+        monkeypatch.setattr(pool, "_adjust_thread_count", adjustment)
+        # A real executor barrier drains queued work; all threads are test-owned.
+        pool.submit(lambda: None).result(timeout=2)
+        assert observers._slots._value == observers._MAX_DELIVERIES
+        pool.shutdown(wait=False)
+        for thread in pool._threads:
+            thread.join(timeout=2)
+            assert not thread.is_alive(), "owned observer worker did not finish"
