# Weights, shards, and media checkpoints stay on local disk only.
/models/

# Generated proofs are local; placeholders and compatibility links are tracked.
/proofs/**
!/proofs/**/
!/proofs/**/.gitkeep

# Local virtualenvs and nested upstream checkouts.
/venvs/
/tools/ComfyUI/
/tools/qwen38-mtp/

# Runtime logs, router snapshots, locks, stamps, and transfer debris.
/logs/
router-state.json
*.log
*.lock
# This is a dependency hash lock, not a transient process lock.
!/verification/candidate-qualification/requirements.lock
*.partial
*.recovered
# Durable state is published by writing "<name>.tmp" and renaming. A crash
# between those two steps leaves the temp file behind; "*.tmp.*" only covers the
# pid-suffixed qualification variant, so cover the plain suffix too.
*.tmp
*.tmp.*
*.ok

# Python debris.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Ad-hoc probe dumps. Keep named fixtures under verification/*/fixtures/.
/verify-*
/verification/hermes-*.png
/verification/hermes-*-output.txt
/verification/hermes-*-usage.json
/verification/direct-*.json
/verification/router-state-after-direct.json
/verification/workspace-move-report.json
/verification/obliterated-mmproj-download.log
/verification/**/evidence/
/verification/qualification-supervisor/qualification-cache/
# Waveforms the TTS gate synthesises on every run. Same class as evidence: gate
# output, not repository state, and not a fixture -- the gate's inputs are the
# tracked reference clips under local-coverage-foundation/fixtures/asr/. Four of
# them were swept into e86383b by an unscoped `git add`, where they broke the
# tracked-file coverage check and made each gate run dirty the tree the qualification
# fingerprints. Named exactly rather than as `*.wav`, which would also swallow
# those fixtures.
/verification/tts-local/artifacts/
/verification/**/build-*/
/verification/glm53flash-local/build-*/
/verification/**/transcript-*.jsonl
/verification/**/download-state*.json
/verification/**/qualification-state.json
/verification/tmp/
# MIOpen's user performance database and compiled-kernel cache. Redirected
# here by the qualification unit because ProtectHome=read-only blocks the default
# under $HOME; it is a rebuildable runtime cache, not repository state.
/verification/miopen/
/verification/**/lane.json
/verification/prompt-corpus-admission/corpora/
/verification/qwen38-obliterated-functional/*.json
/verification/qwen38-obliterated-functional/*.txt
/verification/glm53flash-local/gate-glm32.json
/verification/glm53flash-local/verified-state.json
/verification/glm53flash-local/hf-tree.json
/verification/obliteratus-hf-inventory-*.json
/verification/local-coverage-foundation/research/hf/
/verification/local-coverage-foundation/continuation*.md
/verification/local-coverage-foundation/pre-reboot-kernel-baseline.json

# Editor and OS noise.
.DS_Store
*~
*.swp

verification/qualification-supervisor/*.performance.jsonl
