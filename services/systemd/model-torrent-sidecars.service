[Unit]
Description=Generate local model torrent and magnet sidecars (no seeding)
ConditionPathIsDirectory=%h/git/frankenstein-llm/models

[Service]
Type=oneshot
WorkingDirectory=%h/git/frankenstein-llm
ExecStart=/usr/bin/python3 %h/git/frankenstein-llm/scripts/model-torrent-sidecars.py --root %h/git/frankenstein-llm/models --report %h/git/frankenstein-llm/proofs/torrents/latest.json
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=infinity
SuccessExitStatus=2
