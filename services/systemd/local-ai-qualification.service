[Unit]
Description=Serialized non-benchmark local AI qualification
After=network-online.target llama-router.service local-ai-model-downloads.service local-ai-model-downloads-phase2.service local-ai-model-downloads-phase3.service local-ai-model-downloads-phase4.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /home/typhoon/git/frankenstein-llm/verification/tmp
ExecStartPre=/usr/bin/mkdir -p /home/typhoon/git/frankenstein-llm/verification/miopen/cache
ExecStart=/usr/bin/python3 /home/typhoon/git/frankenstein-llm/verification/qualification-supervisor/run_qualification.py
TimeoutStartSec=infinity
Nice=5
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
# ProtectSystem=strict remounts /tmp read-only unless listed. Torch, TTS,
# ComfyUI and tempfile all need a real temp dir; venvs/tools need write for
# bytecode and ComfyUI runtime files.
ReadWritePaths=/home/typhoon/git/frankenstein-llm/verification /home/typhoon/git/frankenstein-llm/models /home/typhoon/git/frankenstein-llm/venvs /home/typhoon/git/frankenstein-llm/tools /tmp /var/tmp /run/user/%U
Environment=TMPDIR=/home/typhoon/git/frankenstein-llm/verification/tmp
Environment=TMP=/home/typhoon/git/frankenstein-llm/verification/tmp
Environment=TEMP=/home/typhoon/git/frankenstein-llm/verification/tmp
# MIOpen keeps a user performance database and a compiled-kernel cache under
# $HOME by default, and takes a lock file beside the database before it reads
# either. ProtectHome=read-only makes creating that lock fail, and MIOpen
# reports the failure as miopenStatusUnknownError from whatever convolution
# happened to run first. That is not a model or a weights problem: it took out
# wemm-embeddings, computer-use-grounding and generative-media-functional in
# the 2026-09-07 00:38 run, each with the same opaque code. Redirect both paths
# into the checkout, which ReadWritePaths already covers, rather than opening a
# hole in ProtectHome. The cache persists between runs on purpose: recompiling
# kernels on every qualification is minutes of GPU time for no benefit.
Environment=MIOPEN_USER_DB_PATH=/home/typhoon/git/frankenstein-llm/verification/miopen
Environment=MIOPEN_CUSTOM_CACHE_DIR=/home/typhoon/git/frankenstein-llm/verification/miopen/cache

[Install]
WantedBy=default.target
