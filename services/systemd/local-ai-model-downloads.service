[Unit]
Description=Download and verify the maintained local AI model queues
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A user unit's After=network-online.target does not wait for the system network:
# the service starts at login, and on 2026-09-29 two consecutive boots failed their
# first transfers with aria2c exit 19 (name resolution) before DNS was up. Wait,
# bounded, until the Hub resolves.
ExecStartPre=/usr/bin/timeout 300 /usr/bin/sh -c 'until getent ahosts huggingface.co >/dev/null; do sleep 5; done'
ExecStart=/usr/bin/python3 /home/typhoon/git/frankenstein-llm/verification/local-coverage-foundation/download_service.py
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity
Nice=15
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/typhoon/git/frankenstein-llm/models /home/typhoon/git/frankenstein-llm/verification/local-coverage-foundation
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_DOWNLOAD_WORKERS=16
Environment=HERMES_DOWNLOAD_CONNECTION_BUDGET=32

[Install]
WantedBy=default.target
