# Qwen3-Embedding-8B Q6_K served by the installed stable llama.cpp build.
# Pooling is 'last': Qwen3-Embedding is a causal LM whose sentence vector is the
# final-token hidden state. Using mean/cls here silently degrades recall.
# UBATCH must be >= the longest single chunk, because a pooled sequence cannot be
# split across micro-batches; the RAG ingester caps chunks well under this.
SIDECAR_PORT=8081
SIDECAR_ALIAS=qwen3-embedding-8b
SIDECAR_MODEL=/home/typhoon/git/frankenstein-llm/models/embedding/Qwen3-Embedding-8B-Q6_K.gguf
SIDECAR_DEVICE=ROCm0,ROCm1,ROCm2
SIDECAR_NGL=all
SIDECAR_CTX=4096
SIDECAR_BATCH=4096
SIDECAR_UBATCH=4096
SIDECAR_EXTRA_ARGS=--embedding --pooling last --embd-normalize 2 --flash-attn on --tensor-split 3,6,2
