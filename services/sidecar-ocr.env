# HunyuanOCR 1B + its matching projector, both from the first-party ggml-org
# conversion. bf16 on a 1B model costs ~2 GiB and avoids quantisation damage on
# dense glyphs. Temperature 0: OCR is transcription, not generation.
SIDECAR_PORT=8083
SIDECAR_ALIAS=hunyuan-ocr
SIDECAR_MODEL=/home/typhoon/git/frankenstein-llm/models/ocr/HunyuanOCR-bf16.gguf
SIDECAR_DEVICE=ROCm0,ROCm1,ROCm2
SIDECAR_NGL=all
SIDECAR_CTX=16384
SIDECAR_BATCH=2048
SIDECAR_UBATCH=2048
SIDECAR_EXTRA_ARGS=--mmproj /home/typhoon/git/frankenstein-llm/models/ocr/mmproj-HunyuanOCR-bf16.gguf --temp 0 --flash-attn off --cache-type-v f16 --tensor-split 3,6,2
