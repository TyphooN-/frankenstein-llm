# Exactly the artifact llama-server's own --fim-qwen-7b-default resolves to, so
# the prefix/suffix/middle special tokens the /infill endpoint needs are known
# present rather than assumed. Served plain: /infill reads FIM tokens from the
# GGUF, no chat template involved.
SIDECAR_PORT=8084
SIDECAR_ALIAS=qwen25-coder-7b-fim
SIDECAR_MODEL=/home/typhoon/git/frankenstein-llm/models/fim/qwen2.5-coder-7b-q8_0.gguf
SIDECAR_DEVICE=ROCm0,ROCm1,ROCm2
SIDECAR_NGL=all
SIDECAR_CTX=32768
SIDECAR_BATCH=1024
SIDECAR_UBATCH=512
SIDECAR_EXTRA_ARGS=--cache-type-k q8_0 --cache-type-v q8_0 --flash-attn on --tensor-split 3,6,2
