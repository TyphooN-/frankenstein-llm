+#ifndef _WIN32
+// Run before common_init in a fresh process, not a fork inheriting the logger's locks.
+static int ssm_conv_unconverted_kernel() {
+    const struct rlimit no_core = {0, 0};
+    if (setrlimit(RLIMIT_CORE, &no_core) != 0) {
+        return 2;
+    }
+    setenv("GGML_NO_BACKTRACE", "1", 1);
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (dev == nullptr) {
+        return 2;
+    }
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    if (backend == nullptr) {
+        return 2;
+    }
+    ggml_init_params params = {
+        /*.mem_size   =*/ ggml_tensor_overhead()*8 + ggml_graph_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context * ctx = ggml_init(params);
+    if (ctx == nullptr) {
+        return 2;
+    }
+    const int64_t d_conv = 4, d_inner = 128, n_t = 8, n_s = 2;
+    ggml_tensor * x = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d_conv - 1 + n_t, d_inner, n_s);
+    ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, d_conv, d_inner);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, ggml_ssm_conv(ctx, x, w));
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    if (buf == nullptr) {
+        return 2;
+    }
+    ggml_backend_buffer_clear(buf, 0);
+    const ggml_status status = ggml_backend_graph_compute(backend, gf);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    ggml_backend_free(backend);
+    return status == GGML_STATUS_SUCCESS ? 0 : 2; // zero means the invalid kernel was accepted
+}
+
+static bool ssm_conv_rejects_unconverted_kernel(const char * program) {
+    fflush(stdout);
+    fflush(stderr);
+    char * args[] = {const_cast<char *>(program), const_cast<char *>("--ssm-conv-unconverted-kernel"), nullptr};
+#ifdef __APPLE__
+    char ** child_env = *_NSGetEnviron();
+#else
+    extern char ** environ;
+    char ** child_env = environ;
+#endif
+    pid_t pid;
+    const int error = posix_spawnp(&pid, program, nullptr, nullptr, args, child_env);
+    if (error != 0) {
+        fprintf(stderr, "%s: posix_spawnp failed: %s\n", __func__, strerror(error));
+        return false;
+    }
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+    int status = 0;
+    for (;;) {
+        const pid_t waited = waitpid(pid, &status, WNOHANG);
+        if (waited == pid) {
+            return WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT;
+        }
+        if (waited < 0 && errno != EINTR) {
+            return false;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+            kill(pid, SIGKILL);
+            while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+            fprintf(stderr, "%s: child timed out\n", __func__);
+            return false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+}
+#endif // _WIN32
+
+// a model with F16/BF16 conv kernels must give the logits of the same model with the kernel values stored as F32
+static int test_conv_kernel_types(const std::string & arch_filter, const size_t seed, const float stdev,
+        const int verbosity, const char * program, const char * target_backend) {
+    bool all_ok = true;
+#ifndef _WIN32
+    const bool rejected = ssm_conv_rejects_unconverted_kernel(program);
+    printf("ssm_conv with an unconverted F16 kernel: %s\n", rejected ? "aborts (OK)" : "FAIL: accepted");
+    all_ok = all_ok && rejected;
+#else
+    (void) program;
+#endif // _WIN32
+
+    struct user_data_t {
+        struct {
+            ggml_log_callback callback;
+            void * user_data;
+        } log_old;
+
+        int verbosity;
+
+        user_data_t(int verbosity) : verbosity(verbosity) {
+            llama_log_get(&log_old.callback, &log_old.user_data);
+        }
+    };
+    user_data_t ud(verbosity);
+
+    llama_log_set([](ggml_log_level level, const char * text, void * user_data) {
+        const user_data_t * ud = (const user_data_t *) user_data;
+        int verbosity = common_log_get_verbosity(level);
+        if (verbosity <= ud->verbosity) {
+            ud->log_old.callback(level, text, ud->log_old.user_data);
