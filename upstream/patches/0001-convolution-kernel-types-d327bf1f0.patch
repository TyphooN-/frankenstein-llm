+
+// F32 kernel with the values of a kernel_type kernel: the reference for a graph that casts the kernel to F32
+static void set_tensor_data_rounded_conv(struct ggml_tensor * tensor, void * userdata) {
+    rounded_conv_data * ud = (rounded_conv_data *) userdata;
+    tensor_data_params params = {ud->seed, ud->stdev};
+    if (tensor->type != GGML_TYPE_F32 || !is_conv_kernel(ud->arch, tensor->name)) {
+        set_tensor_data(tensor, &params);
+        return;
+    }
+    ud->n_conv++;
+    std::vector<float> tmp(ggml_nelements(tensor));
+    fill_normal(tmp, tensor->name, params);
+    for (float & x : tmp) {
+        x = ud->kernel_type == GGML_TYPE_F16 ? ggml_fp16_to_fp32(ggml_fp32_to_fp16(x)) : ggml_bf16_to_fp32(ggml_fp32_to_bf16(x));
+    }
+    ggml_backend_tensor_set(tensor, tmp.data(), 0, ggml_nbytes(tensor));
+}
