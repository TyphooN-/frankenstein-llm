+// ssm_conv reads an F32 kernel on every backend, but the model file may store it as F16/BF16
+static inline ggml_tensor * build_ssm_conv(ggml_context * ctx, ggml_tensor * conv_x, ggml_tensor * conv_w) {
+    if (conv_w->type != GGML_TYPE_F32) {
+        conv_w = ggml_cast(ctx, conv_w, GGML_TYPE_F32);
+    }
+
+    return ggml_ssm_conv(ctx, conv_x, conv_w);
+}
