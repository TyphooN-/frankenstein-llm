+            continue;
+        }
+        if (arch == LLM_ARCH_GEMMA4 || arch == LLM_ARCH_GEMMA4_ASSISTANT) {
+            continue; // FIXME: ISWA KV cache initialization needs more fixture params
+        }
+        if (arch == LLM_ARCH_EAGLE3 || arch == LLM_ARCH_DFLASH) {
+            continue;
+        }
+        if (!arch_supported(arch)) {
+            continue;
+        }
+        const bool encode = arch == LLM_ARCH_T5 || arch == LLM_ARCH_DREAM || arch == LLM_ARCH_LLADA || arch == LLM_ARCH_LLADA_MOE || arch == LLM_ARCH_RND1;
+        for (bool moe : {false, true}) {
+            if (moe && !moe_implemented(arch)) {
+                continue;
+            }
+            if (!moe && moe_mandatory(arch)) {
+                continue;
+            }
+            for (const ggml_type kernel_type : {GGML_TYPE_F16, GGML_TYPE_BF16}) {
+                gguf_context_ptr gguf_ref = get_gguf_ctx(arch, moe);
+                gguf_context_ptr gguf_typed = get_gguf_ctx(arch, moe);
+                if (arch == LLM_ARCH_BAILINGMOE3) {
+                    GGML_ASSERT(gguf_remove_key(gguf_ref.get(), "bailingmoe3.kda.safe_gate") >= 0);
+                    GGML_ASSERT(gguf_remove_key(gguf_typed.get(), "bailingmoe3.kda.safe_gate") >= 0);
+                }
+                const int64_t key_n_layer = gguf_find_key(gguf_typed.get(), llama_arch_kv_name(arch, LLM_KV_BLOCK_COUNT).c_str());
+                GGML_ASSERT(key_n_layer >= 0);
+                const uint32_t n_layer = gguf_get_val_u32(gguf_typed.get(), key_n_layer);
+                for (const char * pattern : conv_kernel_names) {
+                    for (uint32_t il = 0; il < n_layer; il++) {
