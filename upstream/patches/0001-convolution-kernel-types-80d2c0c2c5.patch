+#ifndef _WIN32
+// Run before common_init in a fresh process, not a fork inheriting the logger's locks.
+static int ssm_conv_unconverted_kernel() {
+    const struct rlimit no_core = {0, 0};
+    if (setrlimit(RLIMIT_CORE, &no_core) != 0) {
+        return 2;
+    }
+    setenv("GGML_NO_BACKTRACE", "1", 1);
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (dev == nullptr) {
+        return 2;
+    }
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    if (backend == nullptr) {
+        return 2;
+    }
+    ggml_init_params params = {
+        /*.mem_size   =*/ ggml_tensor_overhead()*8 + ggml_graph_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context * ctx = ggml_init(params);
+    if (ctx == nullptr) {
+        return 2;
+    }
+    const int64_t d_conv = 4, d_inner = 128, n_t = 8, n_s = 2;
+    ggml_tensor * x = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d_conv - 1 + n_t, d_inner, n_s);
+    ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, d_conv, d_inner);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, ggml_ssm_conv(ctx, x, w));
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    if (buf == nullptr) {
+        return 2;
+    }
+    ggml_backend_buffer_clear(buf, 0);
+    const ggml_status status = ggml_backend_graph_compute(backend, gf);
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+    ggml_backend_free(backend);
+    return status == GGML_STATUS_SUCCESS ? 0 : 2; // zero means the invalid kernel was accepted
+}
