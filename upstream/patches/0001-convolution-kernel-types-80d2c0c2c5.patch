+                        memset(&t, 0, sizeof(ggml_tensor));
+                        t.type = kernel_type;
+                        ggml_format_name(&t, pattern, (int) il);
+                        gguf_add_tensor(gguf_typed.get(), &t);
+                    }
+                }
+
+                rounded_conv_data rd = { seed, kernel_type, stdev };
+                tensor_data_params params_typed = {seed, stdev};
+                auto ref   = get_model_and_ctx(gguf_ref.get(),   nullptr, seed, stdev, {}, LLAMA_SPLIT_MODE_LAYER, encode, nullptr, 0, set_tensor_data_rounded_conv, &rd);
+                auto typed = get_model_and_ctx(gguf_typed.get(), nullptr, seed, stdev, {}, LLAMA_SPLIT_MODE_LAYER, encode, nullptr, 0, set_tensor_data, &params_typed);
+                if (rd.n_conv == 0) {
+                    continue; // this graph takes none of the kernels
+                }
+                n_tested++;
+
+                const std::vector<float> logits_ref   = get_logits(ref.first.get(),   ref.second.get(),   tokens, encode);
+                const std::vector<float> logits_typed = get_logits(typed.first.get(), typed.second.get(), tokens, encode);
+                const bool same = logits_ref == logits_typed;
+                all_ok = all_ok && same;
+                printf("%s (%s) %s kernels on CPU: %s (NMSE %.2e)\n", llama_arch_name(arch), moe ? "MoE" : "dense",
+                    ggml_type_name(kernel_type), same ? "identical to F32 (OK)" : "FAIL", nmse(logits_ref, logits_typed));
+
+                for (size_t i = 0; i < ggml_backend_dev_count(); i++) {
+                    ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+                    if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+                        continue;
+                    }
+                    if (target_backend != nullptr && strcmp(target_backend, ggml_backend_dev_name(dev)) != 0) {
+                        continue;
+                    }
+                    tensor_data_params params_dev = {seed, stdev};
