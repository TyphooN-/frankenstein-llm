+// GGUF convolution names, without linking the internal LLM_TN implementation
+static const char * conv_kernel_names[] = {
+    "blk.%d.ssm_conv1d.weight",
+    "blk.%d.ssm_conv1d_q.weight",
+    "blk.%d.ssm_conv1d_k.weight",
+    "blk.%d.ssm_conv1d_v.weight",
+    "blk.%d.shortconv.conv.weight",
+    "blk.%d.ple_conv1d.weight",
+};
+
+static bool is_conv_kernel(const char * name) {
+    for (const char * pattern : conv_kernel_names) {
+        for (int il = 0; il < 64; il++) {
+            char expected[GGML_MAX_NAME];
+            snprintf(expected, sizeof(expected), pattern, il);
+            if (strcmp(expected, name) == 0) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
